# Copy this file to .env.local and fill in values from your Supabase
# project settings (Project Settings -> API).

# Safe to expose to the browser — used by the anon/public client.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# NEVER prefix this with NEXT_PUBLIC_. It must only ever be read on the
# server (see src/lib/supabase/admin.ts) — bundling it into client
# JavaScript would give every visitor full database access.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudinary (product image uploads). Both values are meant to be public
# — that's how an *unsigned* upload preset works — so NEXT_PUBLIC_ is
# correct here, unlike the service role key above. What actually keeps
# this safe is configuring the preset itself in the Cloudinary
# dashboard (Signing Mode: Unsigned, restricted formats, a max file
# size). See README.md "Product image uploads (Cloudinary)".
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset-name
